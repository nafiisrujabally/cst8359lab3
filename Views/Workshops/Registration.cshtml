@model List<Workshop_RSVP.Models.Rsvp>

<h2>All Registrations</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Workshop</th>
            <th>Accommodation</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rsvp in Model)
        {
            <tr>
                <td>@rsvp.FullName</td>
                <td>@rsvp.WorkshopTitle</td>
                <td>@(rsvp.NeedsAccommodation ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>
